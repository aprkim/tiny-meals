rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read all data (client-side filtering by user_id)
    // This is necessary for cross-device sync functionality
    match /ideas/{ideaId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.user_id == request.auth.uid ||
        exists(/databases/$(database)/documents/user_links/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_links/$(request.auth.uid)).data.linked_to == resource.data.user_id
      );
    }

    match /recipes/{recipeId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.user_id == request.auth.uid ||
        exists(/databases/$(database)/documents/user_links/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_links/$(request.auth.uid)).data.linked_to == resource.data.user_id
      );
    }

    match /history/{historyId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    match /guests/{guestId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    // User links - map synced devices to original user
    match /user_links/{userId} {
      allow create, update: if request.auth != null && userId == request.auth.uid;
      allow read: if request.auth != null;
      allow delete: if request.auth != null && userId == request.auth.uid;
    }

    // Weekly plans - allow access if user owns or is linked
    match /weekly_plans/{planId} {
      allow create, read: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.user_id == request.auth.uid ||
        exists(/databases/$(database)/documents/user_links/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_links/$(request.auth.uid)).data.linked_to == resource.data.user_id
      );
    }

    // Sync codes - allow creating and reading sync codes
    match /sync_codes/{syncCode} {
      // Anyone authenticated can create a sync code with their user_id
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      // Anyone authenticated can read any sync code (needed to link devices)
      allow read: if request.auth != null;
      // Only allow updates/deletes by the owner
      allow update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    // Legacy Tiny Nudge support (if needed)
    match /tinyNudge/{syncCode} {
      allow read, write: if request.auth != null;
    }
  }
}
